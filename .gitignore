node_modules/
.env
.env.local
*.log
.DS_Store
Thumbs.db

# Local Cursor/WebQA development state
.cursor/webqa.env
qa-runs/
tools/cursor-webqa/node_modules/

# Accept-dogfood generated state (keep *.mjs harness sources)
tools/accept-dogfood/.chrome-profile*/
tools/accept-dogfood/**/extension-accept-results.json
tools/accept-dogfood/assets/
tools/accept-dogfood/*.json

# AutoQA run artifacts and local browser profiles (keep harness sources + state)
.autoqa/runs/**
!.autoqa/runs/.gitkeep
.autoqa/profiles/
.autoqa/chrome-profile/
.autoqa/browser-capability.json
.autoqa/chrome-permission-state.json
tools/autoqa/.chrome-profile*/
AUTOQA_BOOTSTRAP_PROBE.tmp.md

# Full-site audit local persistence (services/api uses AUDIT_DB_PATH to relocate this)
data/

# Local AI-tool installs. These are per-developer, are not part of the product,
# and were showing as untracked noise in every `git status`. The Cursor
# equivalent under .cursor/ IS tracked, because those skills are shared.
.claude/
.impeccable/hook.cache.json
.github/agents/
.github/hooks/
.github/skills/
# The Impeccable design skill installs into every tool it finds. Its Cursor
# copy is the same per-developer install as the Claude one above; the project's
# own Cursor agents and skills beside it stay tracked.
.cursor/skills/impeccable/
.cursor/agents/impeccable-*.md
.cursor/hooks.json
