node_modules/
.env
.env.local
*.log
.DS_Store
Thumbs.db

# Local QA artifacts. May carry screenshots and page context from real sites.
qa-runs/

# Accept-dogfood generated state (keep *.mjs harness sources)
tools/accept-dogfood/.chrome-profile*/
tools/accept-dogfood/**/extension-accept-results.json
tools/accept-dogfood/assets/
tools/accept-dogfood/*.json

# AutoQA run artifacts and local browser profiles (keep harness sources + state)
.autoqa/runs/**
!.autoqa/runs/.gitkeep
.autoqa/profiles/
.autoqa/chrome-profile/
.autoqa/browser-capability.json
.autoqa/chrome-permission-state.json
tools/autoqa/.chrome-profile*/
AUTOQA_BOOTSTRAP_PROBE.tmp.md

# Full-site audit local persistence (services/api uses AUDIT_DB_PATH to relocate this)
data/

# Per-developer AI-tool install. Not part of the product, and nothing in the
# build depends on it. Anything a reader is told to run lives in the repository
# instead, which is why the verification harness sits at tools/autoqa/driver.mjs
# rather than under here.
.claude/
