# Copy this file to .cursor/webqa.env. The real file is git-ignored.
# No OpenAI or Anthropic API key is required for this setup.
WEBQA_GATEWAY_URL=https://assistant.msschermer.us

# Optional. Leave blank initially to use Playwright MCP Bridge manual tab approval.
# If you later choose persistent bridge authentication, paste only the local
# PLAYWRIGHT_MCP_EXTENSION_TOKEN value here. Keep this file local only.
PLAYWRIGHT_MCP_EXTENSION_TOKEN=
