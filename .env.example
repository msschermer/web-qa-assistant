PORT=3000
PUBLIC_BASE_URL=https://assistant.msschermer.us
EXTENSION_STORE_URL=
RENDERER_URL=http://localhost:8790
RENDERER_TOKEN=change-me
EGRESS_PROXY_URL=http://localhost:8899

META_STATE_URL=https://meta-state.msschermer.us
META_STATE_PATH=/api/inspect
# Optional dedicated health route; blank uses the real capability endpoint.
META_STATE_HEALTH_PATH=
PERFORMANCE_MONITOR_URL=https://psi.msschermer.us
PERFORMANCE_MONITOR_HEALTH_PATH=
WCAG_TRANSLATOR_URL=https://wcag-translator.msschermer.us
WCAG_TRANSLATOR_PATH=/v1/translate
WCAG_TRANSLATOR_HEALTH_PATH=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_BRIEF_MODEL=
# Public web scanner uses deterministic guidance by default even when OpenAI is configured.
PUBLIC_AI_ENABLED=false
OPENAI_TIMEOUT_MS=12000
FRANK_CACHE_MS=1800000
CONNECTOR_TIMEOUT_MS=5000
SCAN_TIMEOUT_MS=30000

# Optional developer/team override. Never bundle this shared secret in the extension.
ASSISTANT_ACCESS_TOKEN=
# Managed installation access lets a normal extension install obtain a short-lived, per-install signed token automatically.
# This is public distribution access with rate limiting/accounting, not a hidden client secret. Keep false for private-only deployments.
PUBLIC_EXTENSION_ACCESS_ENABLED=false
# Use a long random value. If blank, ASSISTANT_ACCESS_TOKEN is used as the signing secret when available.
INSTALL_TOKEN_SECRET=
INSTALL_TOKEN_TTL_MS=2592000000
INSTALL_AI_DAILY_LIMIT=200
REVOKED_INSTALLATION_IDS=
OPENAI_HEALTH_CACHE_MS=300000
OPENAI_HEALTH_TIMEOUT_MS=6000
OPENAI_HEALTH_MODEL=
# Comma-separated browser origins, or * while developing. For a team deployment, use the exact web and chrome-extension origins.
ALLOWED_ORIGINS=*
