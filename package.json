{
  "name": "web-qa-assistant",
  "version": "1.7.4",
  "private": true,
  "type": "module",
  "description": "Connected web QA with Frank, an AI-guided engineering investigation layer grounded in deterministic evidence.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:renderer": "node services/renderer/server.js",
    "dev:proxy": "node services/egress-proxy/server.js",
    "build:extension": "node scripts/build-extension.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.js",
    "start": "node services/api/server.js",
    "dev:api": "node services/api/server.js",
    "release:validate": "node scripts/validate-release.mjs",
    "benchmark:corpus": "node scripts/benchmark-corpus.mjs"
  },
  "dependencies": {
    "axe-core": "^4.13.0",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "playwright": "^1.62.1",
    "undici": "^8.10.0"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "jsdom": "^30.0.1"
  }
}
