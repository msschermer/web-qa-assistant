{
  "name": "web-qa-assistant",
  "version": "1.7.5",
  "private": true,
  "type": "module",
  "description": "Lumen — evidence-first web QA that shows what the page is actually doing.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:renderer": "node services/renderer/server.js",
    "dev:proxy": "node services/egress-proxy/server.js",
    "build:web-css": "node scripts/build-css.mjs",
    "build:extension": "node scripts/build-extension.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.js",
    "start": "node services/api/server.js",
    "dev:api": "node services/api/server.js",
    "release:validate": "node scripts/validate-release.mjs",
    "benchmark:corpus": "node scripts/benchmark-corpus.mjs",
    "autoqa:activate": "node tools/autoqa/activate.mjs",
    "autoqa:deactivate": "node tools/autoqa/deactivate.mjs",
    "autoqa:bootstrap-proof": "node tools/autoqa/bootstrap-proof.mjs",
    "autoqa:dogfood": "node tools/autoqa/dogfood.mjs",
    "autoqa:fixture-server": "node tools/autoqa/fixture-server.mjs"
  },
  "dependencies": {
    "axe-core": "^4.13.0",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "undici": "^8.10.0"
  },
  "engines": {
    "node": ">=24"
  }
}
